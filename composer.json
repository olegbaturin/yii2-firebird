{
    "name": "edgardmessias/yii2-firebird",
    "description": "Firebird connector for Yii2 framework",
    "keywords": ["yii2", "firebird", "database"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/edgardmessias/yii2-firebird/issues",
        "forum": "https://forum.yiiframework.com/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "source": "https://github.com/edgardmessias/yii2-firebird"
    },
    "authors": [
        {
            "name": "Edgard Lorraine Messias",
            "email": "edgardmessias@gmail.com"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "ext-pdo": "*",
        "ext-pdo_firebird": "*",
        "yiisoft/yii2": "~2.0.55"
    },
    "require-dev": {
        "yiisoft/yii2-coding-standards": "~3.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "edgardmessias\\db\\firebird\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf",
        "tests": "./vendor/bin/phpunit"
    }
}
